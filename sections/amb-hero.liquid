{%- capture focal -%}object-position: {{ section.settings.focal }}{%- endcapture -%}
<section class="amb-hero">
  {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750,1100,1500,2000,2400', sizes: '100vw', loading: 'eager', class: 'cv-fill', alt: section.settings.heading, style: focal }}{%- elsif section.settings.image_fallback != 'none' -%}{% render 'cv-photo', key: section.settings.image_fallback, class: 'cv-fill', alt: section.settings.heading, eager: true, style: focal %}{%- endif -%}
  <div class="amb-hero__in">
    {%- if section.settings.kicker != blank -%}<p class="kicker amb-hero__k">{{ section.settings.kicker }}</p>{%- endif -%}
    <h1 class="display amb-hero__h" data-split>{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: '#apply' }}" class="button button--light">{{ section.settings.button_label }}</a>{%- endif -%}
  </div>
</section>

