<section class="block-pad page page--narrow help">
  {%- if section.settings.heading != blank -%}<h1 class="page__title">{{ section.settings.heading }}</h1>{%- endif -%}
  {%- for block in section.blocks -%}
    {%- assign anchor = block.settings.anchor | default: block.settings.title | handleize -%}
    <div class="help__topic" id="{{ anchor }}" {{ block.shopify_attributes }}>
      <h2 class="help__title">{{ block.settings.title }}</h2>
      <div class="rte">{{ block.settings.text }}</div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Help topics",
  "class": "section-help",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Help" } ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Contact" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Answer goes here.</p>" },
        { "type": "text", "id": "anchor", "label": "Link name", "info": "Used in links like /pages/help#shipping. Defaults to the title." }
      ]
    }
  ],
  "presets": [{ "name": "Help topics" }]
}
{% endschema %}
