<section class="film" id="film" data-film>
  <div class="film__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'metadata',
          class: 'film__video',
          image_size: '2000x' }}
    {%- elsif section.settings.poster != blank -%}
      {{ section.settings.poster | image_url: width: 2400 | image_tag:
          widths: '750,1200,1800,2400', sizes: '100vw', loading: 'lazy', class: 'film__video' }}
    {%- else -%}
      {%- if section.settings.fallback != 'none' -%}
        {% render 'cv-photo', key: section.settings.fallback, class: 'film__video', alt: section.settings.heading %}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'film__video film__placeholder' }}
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="film__content">
    {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="display film__heading" data-split>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.video != blank -%}
      <button type="button" class="button button--light film__sound" data-film-sound aria-pressed="false"
        data-label-on="{{ section.settings.sound_on_label | escape }}"
        data-label-off="{{ section.settings.sound_label | escape }}">{{ section.settings.sound_label }}</button>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '/pages/about' }}" class="button button--light">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

