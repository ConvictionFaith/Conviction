<section class="film" id="film" data-film>
  <div class="film__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'metadata',
          class: 'film__video',
          image_size: '2000x' }}
    {%- elsif section.settings.poster != blank -%}
      {{ section.settings.poster | image_url: width: 2400 | image_tag:
          widths: '750,1200,1800,2400', sizes: '100vw', loading: 'lazy', class: 'film__video' }}
    {%- else -%}
      {%- if section.settings.fallback != 'none' -%}
        {% render 'cv-photo', key: section.settings.fallback, class: 'film__video', alt: section.settings.heading %}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'film__video film__placeholder' }}
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="film__content">
    {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="display film__heading" data-split>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.video != blank -%}
      <button type="button" class="button button--light film__sound" data-film-sound aria-pressed="false"
        data-label-on="{{ section.settings.sound_on_label | escape }}"
        data-label-off="{{ section.settings.sound_label | escape }}">{{ section.settings.sound_label }}</button>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Film",
  "class": "section-film",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Upload the film. It plays muted on loop until someone turns the sound on."
    },
    {
      "type": "select",
      "id": "fallback",
      "label": "Built-in still (used when no video or still is chosen)",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "johnBack",
          "label": "John 16:8 back, close"
        },
        {
          "value": "trio",
          "label": "Trio against the sky (floral)"
        },
        {
          "value": "sunset",
          "label": "Sunset over the hills (John 16:8 back)"
        },
        {
          "value": "hat",
          "label": "éleyxos front, straw hat"
        },
        {
          "value": "jerseyPair",
          "label": "Jersey pair under trees"
        },
        {
          "value": "floralPair",
          "label": "Floral pair on the street"
        },
        {
          "value": "floralChest",
          "label": "Conviction logo close-up"
        },
        {
          "value": "floralBack",
          "label": "Floral back on the street"
        },
        {
          "value": "johnPair",
          "label": "John 16:8 pair on the street"
        },
        {
          "value": "eleyxos",
          "label": "éleyxos close-up"
        },
        {
          "value": "jerseyChest",
          "label": "Jersey chest close-up"
        },
        {
          "value": "levee",
          "label": "Floral front at dusk"
        }
      ],
      "default": "trio"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Still image",
      "info": "Shown if no video is uploaded."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Small line above heading",
      "default": "The film"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made to be asked about"
    },
    {
      "type": "text",
      "id": "sound_label",
      "label": "Sound button",
      "default": "watch with sound"
    },
    {
      "type": "text",
      "id": "sound_on_label",
      "label": "Sound button while playing with sound",
      "default": "mute"
    }
  ],
  "presets": [
    {
      "name": "Film"
    }
  ]
}
{% endschema %}
