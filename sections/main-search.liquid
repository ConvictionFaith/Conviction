{%- assign safe_terms = search.terms | escape -%}
<section class="block-pad search-page">
  <div class="row-head row-head--page">
    <h1 class="row-head__title">{% if search.performed %}{{ 'search.results_for' | t: terms: safe_terms }}{% else %}{{ 'search.title' | t }}{% endif %}</h1>
  </div>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <label for="Search" class="visually-hidden">{{ 'general.search' | t }}</label>
    <input id="Search" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}" class="field">
    <input type="hidden" name="type" value="product">
    <button type="submit" class="button">{{ 'general.search' | t }}</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <ul class="grid grid--3" role="list">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            <li>{% render 'product-card', card_product: item, quick_add: true %}</li>
          {%- else -%}
            <li class="search-page__other"><a href="{{ item.url }}">{{ item.title | escape }}</a></li>
          {%- endif -%}
        {%- else -%}
          <li class="empty">{{ 'search.no_results' | t: terms: safe_terms }}</li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
