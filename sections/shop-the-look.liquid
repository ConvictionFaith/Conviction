<section class="block-pad stl-wrap" data-stl-section>
  <div class="row-head">
    <h2 class="row-head__title">{{ section.settings.heading }}</h2>
    {%- if section.blocks.size > 1 -%}
      <div class="looktabs" role="tablist" aria-label="Looks">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" class="looktab" id="looktab-{{ block.id }}" aria-controls="look-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-look-tab="{{ forloop.index0 }}">Look {{ forloop.index | prepend: '0' | slice: -2, 2 }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- liquid
      assign alt = block.settings.alt | default: section.settings.heading
      assign seen = ''
    -%}
    <div class="stl" id="look-{{ block.id }}" role="tabpanel" data-stl="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
      <div class="stl__media">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750,1100,1500,2000,2400', sizes: '100vw', loading: 'lazy', class: 'cv-fill', alt: alt }}
        {%- elsif block.settings.fallback != 'none' -%}
          {% render 'cv-photo', key: block.settings.fallback, class: 'cv-fill', alt: alt %}
        {%- endif -%}

        {%- for i in (1..3) -%}
          {%- liquid
            assign pkey = 'product_' | append: i
            assign xkey = 'x_' | append: i
            assign ykey = 'y_' | append: i
            assign sp = block.settings[pkey]
          -%}
          {%- if sp != blank -%}
            {%- assign sp_title = sp.metafields.custom.short_title.value | default: sp.title -%}
            <button type="button" class="spot" style="left: {{ block.settings[xkey] }}%; top: {{ block.settings[ykey] }}%"
              data-spot data-x="{{ block.settings[xkey] }}" aria-expanded="false"
              aria-label="{{ sp_title | escape }}, {{ sp.price | money }}"><span></span></button>
            <div class="pop" hidden data-pop>
              <a href="{{ sp.url }}" class="pop__img">
                {%- if sp.featured_media -%}{{ sp.featured_media | image_url: width: 200 | image_tag: class: 'cv-fill', loading: 'lazy', alt: '' }}{%- endif -%}
              </a>
              <div>
                <a href="{{ sp.url }}" class="pop__name">{{ sp_title }}</a>
                <span class="pop__price">{{ sp.price | money }}</span>
              </div>
              {%- if sp.available -%}
                <p class="pop__label">{{ 'products.select_size' | t }}</p>
                {% render 'size-buttons', p: sp, class: 'pop__sizes' %}
              {%- else -%}
                <p class="pop__label">{{ 'products.sold_out' | t }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <p class="stl__list">
        {%- capture items -%}
          {%- for i in (1..3) -%}
            {%- assign pkey = 'product_' | append: i -%}
            {%- assign sp = block.settings[pkey] -%}
            {%- if sp != blank -%}
              {%- assign mark = '|' | append: sp.handle | append: '|' -%}
              {%- unless seen contains mark -%}
                {%- assign seen = seen | append: mark -%}
                <span><a href="{{ sp.url }}" class="text-link">{{ sp.metafields.custom.short_title.value | default: sp.title }}</a> {{ sp.price | money }}</span>
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if items != blank -%}{{ section.settings.in_look }} {{ items | strip | replace: '</span><span>', '</span> · <span>' }}{%- endif -%}
      </p>
    </div>
  {%- endfor -%}
</section>

