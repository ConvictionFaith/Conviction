<section class="block-pad">
  <div class="support">
    <span class="cross" aria-hidden="true"></span>
    <h2 class="display support__h" data-split>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="support__t">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--light">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Dark panel",
  "class": "section-support",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to support us" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>First and foremost, by praying: that we do this with humility, a pure heart, and obedience to Him. Then by wearing the clothes.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the pieces" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Dark panel" }]
}
{% endschema %}
