{%- if section.settings.text != blank -%}
  <div class="announcement" {{ section.shopify_attributes }}>
    <p class="announcement__text">
      {{ section.settings.text }}
      {%- if section.settings.link_label != blank and section.settings.link != blank %}
        <a href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $50" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Link", "default": "/collections/all" }
  ],
  "presets": [{ "name": "Announcement" }]
}
{% endschema %}
