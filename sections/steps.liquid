<section class="block-pad">
  {%- if section.settings.heading != blank -%}<div class="row-head"><h2 class="row-head__title">{{ section.settings.heading }}</h2></div>{%- endif -%}
  <ol class="steps">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}><span class="steps__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></li>
    {%- endfor -%}
  </ol>
</section>

{% schema %}
{
  "name": "Numbered steps",
  "class": "section-steps",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Apply"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Tell us about you."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Numbered steps",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
