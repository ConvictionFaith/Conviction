<section class="password">
  {%- if section.settings.logo != blank -%}
    {{ section.settings.logo | image_url: width: 500 | image_tag: alt: shop.name, class: 'password__logo', widths: '250,500', sizes: '200px' }}
  {%- else -%}
    <p class="header__wordmark">{{ shop.name }}</p>
  {%- endif -%}
  <h1 class="display password__heading">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'password__form' -%}
    {%- if form.errors -%}<p class="product__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label for="Password" class="visually-hidden">{{ 'password.store_password' | t }}</label>
    <input type="password" name="password" id="Password" class="field" placeholder="{{ 'password.store_password' | t }}" autocomplete="current-password">
    <button type="submit" class="button">{{ 'password.enter' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }
  ]
}
{% endschema %}
