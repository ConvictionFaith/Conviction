<section class="block-pad" id="apply">
  <div class="row-head"><h2 class="row-head__title">{{ section.settings.heading }}</h2></div>
  {%- form 'contact', class: 'apply' -%}
    <input type="hidden" name="contact[tags]" value="ambassador-application">
    {%- if form.posted_successfully? -%}
      <p class="apply__wide" role="status">{{ section.settings.success }}</p>
    {%- else -%}
      {%- if form.errors -%}<p class="apply__wide form-note" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label>Name<input class="field" type="text" name="contact[name]" autocomplete="name" required></label>
      <label>Email<input class="field" type="email" name="contact[email]" autocomplete="email" required></label>
      <label>School<input class="field" type="text" name="contact[School]" required></label>
      <label>Instagram<input class="field" type="text" name="contact[Instagram]" placeholder="@"></label>
      <label class="apply__wide">{{ section.settings.why_label }}<textarea class="field" name="contact[body]" rows="4"></textarea></label>
      <button class="button" type="submit">{{ section.settings.button }}</button>
    {%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Application form",
  "class": "section-apply",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Apply"
    },
    {
      "type": "text",
      "id": "why_label",
      "label": "Question",
      "default": "Why do you want to rep Conviction?"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Send application"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Thank-you message",
      "default": "Thanks for applying. We’ll be in touch soon."
    },
    {
      "type": "paragraph",
      "content": "Applications arrive at your store's sender email (Settings → Notifications)."
    }
  ],
  "presets": [
    {
      "name": "Application form"
    }
  ]
}
{% endschema %}
