{%- capture f1 -%}object-position: {{ section.settings.focal_1 }}{%- endcapture -%}{%- capture f2 -%}object-position: {{ section.settings.focal_2 }}{%- endcapture -%}
<section class="photo-strip">
  <div data-reveal>{%- if section.settings.image_1 != blank -%}{{ section.settings.image_1 | image_url: width: 2400 | image_tag: widths: '750,1100,1500,2000,2400', sizes: '(min-width: 750px) 66vw, 100vw', loading: 'lazy', class: 'cv-fill', alt: section.settings.alt_1, style: f1 }}{%- elsif section.settings.image_1_fallback != 'none' -%}{% render 'cv-photo', key: section.settings.image_1_fallback, class: 'cv-fill', alt: section.settings.alt_1, style: f1 %}{%- endif -%}</div>
  <div data-reveal>{%- if section.settings.image_2 != blank -%}{{ section.settings.image_2 | image_url: width: 2400 | image_tag: widths: '750,1100,1500,2000,2400', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', class: 'cv-fill', alt: section.settings.alt_2, style: f2 }}{%- elsif section.settings.image_2_fallback != 'none' -%}{% render 'cv-photo', key: section.settings.image_2_fallback, class: 'cv-fill', alt: section.settings.alt_2, style: f2 %}{%- endif -%}</div>
</section>

