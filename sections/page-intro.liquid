<section class="intro">
  <h1 class="display intro__heading" data-split style="--d: 100ms">{{ section.settings.heading | default: page.title }}</h1>
  {%- if section.settings.image != blank -%}
    <div class="intro__media" data-reveal>
      {{ section.settings.image | image_url: width: 3000 | image_tag:
          widths: '750,1100,1500,2000,3000', sizes: '100vw', loading: 'eager', class: 'intro__img' }}
    </div>
  {%- elsif section.settings.fallback != 'none' -%}
    <div class="intro__media" data-reveal>
      {% render 'cv-photo', key: section.settings.fallback, class: 'intro__img', alt: section.settings.heading, eager: true %}
    </div>
  {%- endif -%}
</section>

