<article class="block-pad page page--narrow">
  <p class="kicker"><a href="{{ blog.url }}">{{ 'blogs.back' | t: title: blog.title }}</a></p>
  <h1 class="page__title">{{ article.title }}</h1>
  <p class="row-head__meta">{{ article.published_at | date: '%B %-d, %Y' }}</p>
  {%- if article.image -%}
    <div class="article__media">{{ article.image | image_url: width: 2000 | image_tag: widths: '750,1200,2000', sizes: '(min-width: 750px) 720px, 100vw', loading: 'eager' }}</div>
  {%- endif -%}
  <div class="rte page__body">{{ article.content }}</div>
</article>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
