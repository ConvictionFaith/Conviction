<section class="block-pad page{% if section.settings.narrow %} page--narrow{% endif %}">
  {%- if section.settings.show_title -%}
    <h1 class="page__title">{{ page.title }}</h1>
  {%- endif -%}
  {%- if page.content != blank -%}
    <div class="rte page__body">{{ page.content }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Page text",
  "class": "section-page",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true },
    { "type": "checkbox", "id": "narrow", "label": "Narrow reading column", "default": true },
    { "type": "paragraph", "content": "This shows the text you write in Online Store → Pages." }
  ]
}
{% endschema %}
