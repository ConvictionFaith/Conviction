<section class="block-pad page page--narrow account">
  <h1 class="page__title">{{ 'customer.account' | t }}</h1>
  <p>{{ customer.name | escape }} · <a href="{{ routes.account_logout_url }}" class="text-link">{{ 'customer.logout' | t }}</a></p>
  <h2 class="page__subtitle">{{ 'customer.orders' | t }}</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table class="table">
        <thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.fulfillment' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%b %-d, %Y' }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p>{{ 'customer.no_orders' | t }}</p>
    {%- endif -%}
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
  <p><a href="{{ routes.account_addresses_url }}" class="text-link">{{ 'customer.view_addresses' | t }} ({{ customer.addresses_count }})</a></p>
</section>
