<section class="block-pad page page--narrow account">
  <h1 class="page__title">{{ 'customer.reset' | t }}</h1>
  {%- form 'reset_customer_password', class: 'stack' -%}
    {{ form.errors | default_errors }}
    <label class="field__label" for="ResetPassword">{{ 'customer.password' | t }}</label>
    <input class="field" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
    <label class="field__label" for="ResetConfirm">{{ 'customer.password' | t }} (again)</label>
    <input class="field" type="password" name="customer[password_confirmation]" id="ResetConfirm" autocomplete="new-password" required>
    <button class="button">{{ 'customer.reset' | t }}</button>
  {%- endform -%}
</section>
