<section class="block-pad page page--narrow account">
  <h1 class="page__title">{{ 'customer.register' | t }}</h1>
  {%- form 'create_customer', class: 'stack' -%}
    {{ form.errors | default_errors }}
    <label class="field__label" for="FirstName">{{ 'customer.first_name' | t }}</label>
    <input class="field" type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">
    <label class="field__label" for="LastName">{{ 'customer.last_name' | t }}</label>
    <input class="field" type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">
    <label class="field__label" for="RegEmail">{{ 'customer.email' | t }}</label>
    <input class="field" type="email" name="customer[email]" id="RegEmail" autocomplete="email" required>
    <label class="field__label" for="RegPassword">{{ 'customer.password' | t }}</label>
    <input class="field" type="password" name="customer[password]" id="RegPassword" autocomplete="new-password" required>
    <button class="button button--block">{{ 'customer.register' | t }}</button>
  {%- endform -%}
</section>
