{%- comment -%}
  The built-in people photos for each product (from the approved demo).
  Accepts: handle, part ('front', 'back', 'flip_front', 'flip_back', 'gallery' or 'has'),
           class, eager, li_class (gallery only)
  part 'has' prints "yes" when the product has built-in photos.
  To use your own photos instead, upload them to the product: these only show
  for the three products below, by their handle.
{%- endcomment -%}
{%- case handle -%}
  {%- when 'conviction-greek-streetwear-t-shirt' -%}
    {%- case part -%}
      {%- when 'has' -%}yes
      {%- when 'front' -%}{% render 'cv-photo', key: 'hat', alt: 'Wearing the John 16:8 tee in a field, éleyxos on the chest', style: 'object-position: 50% 60%', class: class, eager: eager %}
      {%- when 'back' -%}{% render 'cv-photo', key: 'johnBackClean', alt: 'Back of the John 16:8 tee: the falling figure over Conviction and its Greek definition', style: 'object-position: 50% 42%', class: class, eager: eager %}
      {%- when 'flip_front' -%}{% render 'cv-photo', key: 'eleyxos', alt: 'Front: éleyxos in black gothic type on the chest', style: 'object-position: 60% 50%', class: class, eager: eager %}
      {%- when 'flip_back' -%}{% render 'cv-photo', key: 'johnBackClean', alt: 'Back: the falling figure over Conviction and its Greek definition, John 16:8', style: 'object-position: 50% 44%', class: class, eager: eager %}
      {%- when 'gallery' -%}
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'johnPair2', alt: 'Two friends in the John 16:8 tee, one showing the back print, one the éleyxos front', style: 'object-position: 50% 40%', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'johnPair', alt: 'Two friends on a street in the John 16:8 tee, back and front', style: 'object-position: center', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'johnBack', alt: 'Back print: the falling figure over Conviction and its Greek definition', style: 'object-position: 50% 45%', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'johnSmile', alt: 'Smiling in the woods in the John 16:8 tee, éleyxos on the chest', style: 'object-position: 50% 40%', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'stoneTable', alt: 'Sitting on a stone table in the woods, the back print showing', style: 'object-position: 50% 75%', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'hat', alt: 'Head down under a straw hat, éleyxos on the chest', style: 'object-position: center', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'eleyxos', alt: 'Close-up of éleyxos in black gothic type, a cross necklace beside it', style: 'object-position: center', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'sunset', alt: 'Looking out over hills at sunset in the John 16:8 tee', style: 'object-position: 50% 40%', class: class %}</li>
    {%- endcase -%}
  {%- when 'lust-is-not-love-flowers-graphic-tee' -%}
    {%- case part -%}
      {%- when 'has' -%}yes
      {%- when 'front' -%}{% render 'cv-photo', key: 'levee', alt: 'Standing on a levee road at dusk in the Romans 8:5–6 tee, Conviction on the chest', style: 'object-position: 50% 45%', class: class, eager: eager %}
      {%- when 'back' -%}{% render 'cv-photo', key: 'floralBack', alt: 'Back of the Romans 8:5–6 tee: “Lust is not love” over a white bouquet', style: 'object-position: 50% 40%', class: class, eager: eager %}
      {%- when 'flip_front' -%}{% render 'cv-photo', key: 'floralChest', alt: 'Front: the underlined Conviction logo on the chest', style: 'object-position: 55% 50%', class: class, eager: eager %}
      {%- when 'flip_back' -%}{% render 'cv-photo', key: 'floralBack', alt: 'Back: “Lust is not love” over a white bouquet, Romans 8:5–6', style: 'object-position: 50% 40%', class: class, eager: eager %}
      {%- when 'gallery' -%}
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'floralPair', alt: 'Two friends in the Romans 8:5–6 tee, back and front', style: 'object-position: 50% 22%', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'floralBack', alt: 'The full floral back print with Romans 8:5–6', style: 'object-position: center', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'levee', alt: 'Front of the tee, the Conviction logo on the chest', style: 'object-position: center', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'floralChest', alt: 'Close-up of the underlined Conviction logo, a cross necklace beside it', style: 'object-position: center', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'trio', alt: 'Three friends against a blue sky in the Romans 8:5–6 tee', style: 'object-position: center', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'floralWater', alt: 'Standing at the water at dusk, the floral back print showing', style: 'object-position: 50% 50%', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'floralRocks', alt: 'Sitting on rocks by the water in the Romans 8:5–6 tee', style: 'object-position: 20% 90%', class: class %}</li>
    {%- endcase -%}
  {%- when 'romans-86-jersey' -%}
    {%- case part -%}
      {%- when 'has' -%}yes
      {%- when 'front' -%}{% render 'cv-photo', key: 'jerseySolo', alt: 'Smiling on a tree-lined street in the Romans 8:6 jersey, Conviction on the chest', style: 'object-position: 50% 35%', class: class, eager: eager %}
      {%- when 'back' -%}{% render 'cv-photo', key: 'jerseyBack', alt: 'Back of the Romans 8:6 jersey with Romans 8:6 in large gothic type', style: 'object-position: 50% 32%', class: class, eager: eager %}
      {%- when 'flip_front' -%}{% render 'cv-photo', key: 'jerseyChest', alt: 'Front: Conviction in white gothic type, white piping beside it', style: 'object-position: 58% 50%', class: class, eager: eager %}
      {%- when 'flip_back' -%}{% render 'cv-photo', key: 'jerseyBack', alt: 'Back: Romans 8:6 in large white gothic type between white piping', style: 'object-position: 50% 34%', class: class, eager: eager %}
      {%- when 'gallery' -%}
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'jerseyPair', alt: 'Two friends in the Romans 8:6 jersey, back and front', style: 'object-position: center', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'girls', alt: 'Two friends laughing in the Romans 8:6 jersey', style: 'object-position: 60% 40%', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'bench', alt: 'Sitting on a bench in the Romans 8:6 jersey and the John 16:8 tee', style: 'object-position: center', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'jerseyPair2', alt: 'Standing and crouching in the Romans 8:6 jersey on a tree-lined street', style: 'object-position: center', class: class %}</li>
        <li class="{{ li_class }}">{% render 'cv-photo', key: 'jerseySky', alt: 'Romans 8:6 across the back of the jersey under a pink evening sky', style: 'object-position: 50% 60%', class: class %}</li>
    {%- endcase -%}
{%- endcase -%}
