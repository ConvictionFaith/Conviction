{%- comment -%} Threshold is in the store's base currency. {%- endcomment -%}
{%- if settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign remaining_money = remaining | money
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  -%}
  <div class="ship">
    <p class="ship__text">
      {%- if remaining > 0 -%}
        {{ 'cart.free_shipping_away' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'cart.free_shipping_reached' | t }}
      {%- endif -%}
    </p>
    <div class="ship__bar" aria-hidden="true"><span style="width: {{ pct }}%"></span></div>
  </div>
{%- endif -%}
