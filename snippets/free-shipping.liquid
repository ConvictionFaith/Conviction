{%- comment -%} Threshold is in the store's base currency. {%- endcomment -%}
{%- if settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign remaining_money = remaining | money
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  -%}
  <div class="ship">
    <p class="ship__text">
      {%- if remaining > 0 -%}
        {{ 'cart.free_shipping_away' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'cart.free_shipping_reached' | t }}
      {%- endif -%}
    </p>
    <div class="ship__bar" aria-hidden="true"><span style="width: {{ pct }}%"></span></div>
  </div>
  {%- if remaining > 0 -%}
    {%- liquid
      assign in_cart = cart.items | map: 'product_id' | join: ','
      assign in_cart = ',' | append: in_cart | append: ','
      assign pick = nil
      assign fallback_pick = nil
      for cand in collections.all.products limit: 50
        unless cand.available
          continue
        endunless
        if cand.price < remaining
          continue
        endif
        assign mark = ',' | append: cand.id | append: ','
        if in_cart contains mark
          if fallback_pick == nil or cand.price < fallback_pick.price
            assign fallback_pick = cand
          endif
        elsif pick == nil or cand.price < pick.price
          assign pick = cand
        endif
      endfor
      assign pick = pick | default: fallback_pick
    -%}
    {%- if pick -%}
      <div class="nudge">
        <a href="{{ pick.url }}" class="nudge__img">
          {%- capture pick_look -%}{% render 'cv-look', handle: pick.handle, part: 'has' %}{%- endcapture -%}
          {%- if pick_look contains 'yes' -%}{% render 'cv-look', handle: pick.handle, part: 'front', class: 'cv-fill', sizes: '72px' %}
          {%- elsif pick.featured_media -%}{{ pick.featured_media | image_url: width: 160 | image_tag: class: 'cv-fill', loading: 'lazy', alt: '' }}{%- endif -%}
        </a>
        <p>Add the <a href="{{ pick.url }}" class="text-link">{{ pick.metafields.custom.short_title.value | default: pick.title }}</a> ({{ pick.price | money }}) and shipping is free.</p>
        {% render 'size-buttons', p: pick, class: 'nudge__sizes' %}
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
