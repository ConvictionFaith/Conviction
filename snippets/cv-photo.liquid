{%- comment -%}
  Built-in Conviction photo. Color grade is baked into the files.
  Accepts: key, class, alt, style, eager (boolean),
           sizes (optional; guessed from class), defer (boolean: load on hover only)
  Smaller copies exist at 400/700/1000/1400px wide (only below the original width).
{%- endcomment -%}
{%- liquid
  assign w = 1600
  assign h = 1067
  case key
    when 'bench'
      assign w = 2560
      assign h = 1706
    when 'eleyxos'
      assign w = 1200
      assign h = 800
    when 'floralBack'
      assign w = 1100
      assign h = 1650
    when 'floralChest'
      assign w = 1200
      assign h = 800
    when 'floralPair'
      assign w = 1100
      assign h = 1650
    when 'floralRocks'
      assign w = 1100
      assign h = 1650
    when 'floralWater'
      assign w = 2560
      assign h = 1706
    when 'girls'
      assign w = 2560
      assign h = 1707
    when 'hat'
      assign w = 1300
      assign h = 866
    when 'jerseyBack'
      assign w = 1100
      assign h = 1650
    when 'jerseyChest'
      assign w = 1200
      assign h = 800
    when 'jerseyPair'
      assign w = 2560
      assign h = 1706
    when 'jerseyPair2'
      assign w = 2560
      assign h = 1707
    when 'jerseySky'
      assign w = 1100
      assign h = 1650
    when 'jerseySolo'
      assign w = 1100
      assign h = 1650
    when 'johnBack'
      assign w = 1100
      assign h = 1650
    when 'johnBackClean'
      assign w = 1100
      assign h = 1650
    when 'johnPair'
      assign w = 2560
      assign h = 1706
    when 'johnPair2'
      assign w = 1100
      assign h = 1650
    when 'johnSmile'
      assign w = 1100
      assign h = 1650
    when 'levee'
      assign w = 1100
      assign h = 1650
    when 'stoneTable'
      assign w = 1100
      assign h = 1650
    when 'sunset'
      assign w = 2560
      assign h = 1706
    when 'trio'
      assign w = 2560
      assign h = 1706
    when 'trio2'
      assign w = 2560
      assign h = 1706
  endcase
  if key contains 'flat-'
    assign w = 1200
    assign h = 1500
  endif

  assign base = 'cv-' | append: key
  assign src = base | append: '.webp' | asset_url
  assign srcset = ''
  assign steps = '400,700,1000,1400' | split: ','
  for step in steps
    assign sw = step | plus: 0
    if sw < w
      assign f = base | append: '-w' | append: step | append: '.webp' | asset_url
      assign srcset = srcset | append: f | append: ' ' | append: step | append: 'w, '
    endif
  endfor
  assign srcset = srcset | append: src | append: ' ' | append: w | append: 'w'

  assign cls = class | default: ''
  assign s = sizes
  if s == blank
    if cls contains 'card__img'
      assign s = '(min-width: 990px) 33vw, (min-width: 480px) 50vw, 100vw'
    elsif cls contains 'iwt__img'
      assign s = '(min-width: 750px) 50vw, 100vw'
    elsif cls contains 'look__img'
      assign s = '(min-width: 750px) 33vw, 78vw'
    elsif cls contains 'product__img'
      assign s = '(min-width: 990px) 50vw, 100vw'
    elsif cls == ''
      assign s = '120px'
    else
      assign s = '100vw'
    endif
  endif
-%}
{%- if defer -%}
<img data-src="{{ src }}" data-srcset="{{ srcset }}" sizes="{{ s }}" class="{{ cls }}" alt="" aria-hidden="true" width="{{ w }}" height="{{ h }}" decoding="async"
  {%- if style %} style="{{ style }}"{% endif %} data-defer-img>
{%- else -%}
<img src="{{ src }}" srcset="{{ srcset }}" sizes="{{ s }}" class="{{ cls }}" alt="{{ alt | escape }}" width="{{ w }}" height="{{ h }}"
  {%- if style %} style="{{ style }}"{% endif %}
  {%- if eager %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async">
{%- endif -%}

