<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <script>document.documentElement.className = document.documentElement.className.replace("no-js", "js");</script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta name="theme-color" content="{% if settings.color_mode == 'cream' %}#EFE8D8{% else %}#FFFFFF{% endif %}">
    <link rel="canonical" href="{{ canonical_url | escape }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title | escape }}
      {%- if current_tags %} – {{ current_tags | join: ', ' | escape }}{% endif -%}
      {%- if current_page != 1 %} – page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} · {{ shop.name | escape }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- comment -%} Search-engine data (schema.org). Inline so it can never go missing; values escaped with | json. {%- endcomment -%}
    {%- if request.page_type == 'index' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "logo": {{ 'conviction-wordmark.svg' | asset_url | prepend: 'https:' | json }}
      {%- assign same_as = '' -%}
      {%- if settings.social_instagram != blank -%}{%- assign same_as = same_as | append: settings.social_instagram | append: '|' -%}{%- endif -%}
      {%- if settings.social_tiktok != blank -%}{%- assign same_as = same_as | append: settings.social_tiktok | append: '|' -%}{%- endif -%}
      {%- if same_as != blank -%},
      "sameAs": {{ same_as | split: '|' | json }}
      {%- endif %}
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }},
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    {%- elsif request.page_type == 'product' and product -%}
    {%- assign sd_variant = product.selected_or_first_available_variant -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {%- if product.featured_media %}
      "image": [{{ product.featured_media | image_url: width: 1600 | prepend: 'https:' | json }}],
      {%- endif %}
      "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
      {%- if sd_variant.sku != blank %}
      "sku": {{ sd_variant.sku | json }},
      {%- endif %}
      "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
      "offers": [
        {%- for v in product.variants -%}
        {
          "@type": "Offer",
          {%- if v.sku != blank %}
          "sku": {{ v.sku | json }},
          {%- endif %}
          "name": {{ v.title | json }},
          "url": {{ request.origin | append: v.url | json }},
          "price": {{ v.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "{% if v.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
    </script>
    {%- endif -%}
    {%- render 'css-variables' -%}

    {%- if settings.display_style == 'blackletter' or settings.display_style == 'condensed' -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      {%- if settings.display_style == 'condensed' -%}
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&display=swap" media="print" onload="this.media='all'">
        <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&display=swap"></noscript>
      {%- else -%}
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&display=swap" media="print" onload="this.media='all'">
      {%- endif -%}
    {%- endif -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
    <script type="speculationrules">
      {
        "prefetch": [{
          "where": { "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": ["/cart*", "/checkout*", "/checkouts/*", "/account*", "/*/account*", "/password*", "/discount/*", "/*\\?*"] } },
            { "not": { "selector_matches": "[rel~=nofollow], [target=_blank], [data-no-prefetch]" } }
          ]},
          "eagerness": "moderate"
        }]
      }
    </script>
  </head>

  <body class="{% if settings.photo_grade %}has-grade {% endif %}template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#main">Skip to content</a>

    {% sections 'header-group' %}

    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cart: {{ routes.cart_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        strings: {
          adding: {{ 'products.adding' | t | json }},
          added: {{ 'products.added' | t | json }},
          addToBag: {{ 'products.add_to_bag' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          chooseSize: {{ 'products.choose_size' | t | json }},
          sizeLabel: {{ 'products.select_size' | t | json }},
          error: {{ 'cart.error' | t | json }}
        }
      };
    </script>
  </body>
</html>

