[
  {
    "name": "theme_info",
    "theme_name": "Conviction",
    "theme_version": "1.0.0",
    "theme_author": "Conviction",
    "theme_documentation_url": "https://conviction.faith",
    "theme_support_url": "https://conviction.faith/pages/help"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "select",
        "id": "color_mode",
        "label": "Color mode",
        "info": "White uses the colors below; Cream overrides them.",
        "options": [
          {
            "value": "white",
            "label": "White"
          },
          {
            "value": "cream",
            "label": "Cream"
          },
          {
            "value": "dark",
            "label": "Dark (turned off, shows White)"
          }
        ],
        "default": "white"
      },
      {
        "type": "checkbox",
        "id": "photo_grade",
        "label": "Subtle color grade on photos",
        "default": true
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text and buttons",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_stone",
        "label": "Behind product photos",
        "default": "#ECEAE6"
      },
      {
        "type": "color",
        "id": "color_mute",
        "label": "Secondary text",
        "default": "#6E6E6E"
      },
      {
        "type": "color",
        "id": "color_rule",
        "label": "Lines and borders",
        "default": "#DCDCDC"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body and navigation",
        "default": "helvetica_n4"
      },
      {
        "type": "select",
        "id": "display_style",
        "label": "Large headlines",
        "options": [
          {
            "value": "condensed",
            "label": "Condensed bold (matches the logo)"
          },
          {
            "value": "blackletter",
            "label": "Blackletter"
          },
          {
            "value": "sans",
            "label": "Same as body, bold"
          }
        ],
        "default": "condensed"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Max width for text pages",
        "min": 900,
        "max": 1800,
        "step": 50,
        "unit": "px",
        "default": 1400
      }
    ]
  },
  {
    "name": "Bag",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "When someone adds to bag",
        "options": [
          {
            "value": "drawer",
            "label": "Slide out the bag"
          },
          {
            "value": "page",
            "label": "Go to the bag page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "info": "In your store currency. Shows progress in the bag. Set the actual free rate in Settings → Shipping and delivery. Leave at 0 to hide.",
        "default": 50
      },
      {
        "type": "checkbox",
        "id": "cart_notes",
        "label": "Show order note in bag",
        "default": false
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL",
        "default": "https://www.instagram.com/conviction.faith"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL",
        "default": "https://www.tiktok.com/@conviction.faith"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 × 32 px or larger, square."
      }
    ]
  }
]